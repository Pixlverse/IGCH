# Shared secret for POST /api/revalidate (send as the x-revalidate-secret header).
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Public site URL used for canonical/OG/sitemap. Defaults to https://igchkochi.com
NEXT_PUBLIC_SITE_URL=https://igchkochi.com

# ---------- Admin panel ----------

# MongoDB connection string (Atlas: mongodb+srv://user:pass@cluster/igch).
# Local: run `pnpm db:dev` and use mongodb://127.0.0.1:27017/igch
# Without it the site renders the seed content in content/seed and /admin is unavailable.
MONGODB_URI=

# Signs the admin login cookie. At least 32 characters: openssl rand -hex 32
SESSION_SECRET=

# Image and PDF uploads. From the Cloudinary dashboard (API Environment variable).
# Without it, uploads are saved to public/uploads (local development only).
CLOUDINARY_URL=

# First admin account, created by `pnpm seed` when there are no users yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
