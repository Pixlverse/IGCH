,["$","article","Community Health and Patient Support",{"className":"info-card","children":[["$","h3",null,{"children":"Community Health and Patient Support"}],[["$","p","0",{"children":"IGCH's co-operative approach to healthcare extends beyond its hospital services through cancer screening, medical camps, patient assistance and public health awareness programs."}],["$","p","1",{"children":"Accessible healthcare for those who need it most."}]],false,[],null,null]}],["$","article","Emergency Care and Medical Infrastructure",{"className":"info-card","children":[["$","h3",null,{"children":"Emergency Care and Medical Infrastructure"}],[["$","p","0",{"children":"Indira Gandhi Co-operative Hospital (IGCH) has invested in hospital infrastructure, emergency response systems and medical technology to support its range of healthcare services in Kochi."}]],false,[],null,["$","div",null,{"className":"btn-row","children":[["$","$Ld","Learn more about our 24-hour Emergency Care in Kochi",{"href":"/specialities/clinical-support","className":"btn btn--light","children":"Learn more about our 24-hour Emergency Care in Kochi"}]]}]]}],["$","article","Education and Professional Development",{"className":"info-card","children":[["$","h3",null,{"children":"Education and Professional Development"}],[["$","p","0",{"children":"Indira Gandhi College of Nursing provides nursing education through academic programmes and clinical learning opportunities."}]],false,[],null,["$","div",null,{"className":"btn-row","children":[["$","$Ld","Nursing College in Kochi",{"href":"/college-of-nursing","className":"btn btn--light","children":"Nursing College in Kochi"}]]}]]}],["$","article","Accreditations and Recognition",{"className":"info-card","children":[["$","h3",null,{"children":"Accreditations and Recognition"}],[["$","p","0",{"children":"IGCH's institutional accreditations, healthcare empanelments and professional associations support its hospital operations and patient services."}]],false,"$L2a","$L2