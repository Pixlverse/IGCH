13:["$","section",null,{"className":"section section--tight","children":["$","div",null,{"className":"split-banner split-banner--sage split-banner--text","data-reveal":"","children":["$undefined",["$","div",null,{"className":"split-banner__body","children":[["$","span",null,{"className":"tag tag--white","children":"Our Promise"}],["$","h2",null,{"className":"h2 h2--sm","children":"Equal respect for everyone, extra support for those who need it most."}],["$","ul",null,{"className":"mini-cards","children":[["$","li","Equal respect",{"children":[["$","strong",null,{"children":"Equal respect"}],["$","span",null,{"children":"Every patient deserves the same dignity, attention and standard of care, regardless of their financial circumstances."}]]}],["$","li","Support when it is needed",{"children":[["$","strong",null,{"children":"Support when it is needed"}],["$","span",null,{"children":"Eligible patients can access free dialysis, subsidised cancer treatment and medicines through the hospital's patient support initiatives."}]]}],["$","li","Care beyond the hospital",{"children":[["$","strong",null,{"children":"Care beyond the hospital"}],["$","span",null,{"children":"Our commitment extends into the community through weekly free and subsidised medical camps and free meals for cancer patients, provided in association with the Cochin Cancer Society."}]]}]]}],["$","div",null,{"className":"btn-row","children":[null,null]}]]}]]}]}]
14:["$","section",null,{"className":"section","id":"leadership","children":[["$","div",null,{"className":"section-head","data-reveal":"","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"Leadership Messages"}],["$","h2",null,{"className":"h2 h2--wide","children":"The People Leading IGCH Forward"}],""]}],""]}],["$","div",null,{"className":"leaders","data-reveal":"","children":[["$","figure","President, Indira Gandhi Co-operative Hospital (IGCH)",{"className":"leader","children":[["$","div",null,{"className":"leader__art","children":["$","span",null,{"className":"initials","aria-hidden":"true","children":"MJ"}]}],["$","blockquote",null,{"children":["“","Collectively, we are driven by a single overriding goal: to make sure that you, your family, friends and neighbours have access to high-quality, high-value care locally, whenever the need arises.","”"]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"M O John"}],["$","span",null,{"children":"President, Indira Gandhi Co-operative Hospital (IGCH)"}]]}],["$","details",null,{"className":"leader__more","children":[["$","summary",null,{"children":"Read the President’s message"}],["$","div",null,{"className":"leader__letter","children":[["$","p","0",{"children":"Dear Friends,"}],["$","p","1",{"children":"Indira Gandhi Co-operative Hospital stands as a pillar of excellence and progress in healthcare. For more than 50 years, our dedicated team of doctors, nurses and staff has been unwavering in its mission to strengthen both our hospital and the community we proudly serve. Today, that commitment is stronger than ever, as we continue to advance and adapt to meet the evolving needs of our patients."}],["$","p","2",{"children":"Collectively, we are driven by a single overriding goal: to make sure that you, your family, friends and neighbours have access to high-quality, high-value care locally, whenever the need arises."}],["$","p","3",{"children":"As president of this institution, I can attest to the fact that IGCH is a “jewel” of an institution with outstanding depth and breadth of clinical capabilities. Beyond these achievements and milestones, we continue to develop and implement new programs and services to provide you with the very best local care possible. If you haven’t been to IGCH recently, I hope you’ll spend time within this site to learn more about our rapidly expanding array of services and capabilities; there truly is no longer any need to travel out of the city for superior health care."}],["$","p","4",{"children":"During this time of rapid healthcare transformation, and as one of the fastest-growing hospitals in all of Cochin, IGCH is proud to be recognised as a leader in the field across the Ernakulam District. We are indeed \"so good. So caring. So close\", and with your support, we’ll continue to improve IGCH each and every day so we can better serve you, your family and the entire Ernakulam District."}],["$","p","5",{"children":"Sincerely,"}],["$","p","6",{"children":"M O John"}],["$","p","7",{"children":"President, Indira Gandhi Co-operative Hospital (IGCH)"}]]}]]}]]}],["$","figure","Secretary, Indira Gandhi Co-operative Hospital (IGCH)",{"className":"leader","children":[["$","div",null,{"className":"leader__art","children":["$","span",null,{"className":"initials","aria-hidden":"true","children":"N"}]}],["$","blockquote",null,{"children":["“","The hospital has a vision of becoming an ideal centre for health care for the people around the city and surrounding districts, and not of revenue collection.","”"]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"[Name]"}],["$","span",null,{"children":"Secretary, Indira Gandhi Co-operative Hospital (IGCH)"}]]}],["$","details",null,{"className":"leader__more","children":[["$","summary",null,{"children":"Read the Secretary's message"}],"$L29"]}]]}]]}]]}]
