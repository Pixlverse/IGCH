18:["$","section",null,{"className":"section","id":"careers","children":["$","div",null,{"className":"careers","data-reveal":"","children":[["$","div",null,{"className":"careers__main","children":[["$","span",null,{"className":"tag tag--glass","children":"Careers"}],["$","h2",null,{"className":"h2","children":"Make a difference through the work you do."}],["$","p",null,{"children":"We welcome applications from qualified and experienced professionals interested in exploring career opportunities at our hospital."}],["$","div",null,{"className":"btn-row","children":[["$","$Ld","View Current Openings",{"href":"/careers#openings","className":"btn btn--white","children":"View Current Openings"}],["$","$Ld","Submit Your Resume",{"href":"/careers#apply","className":"btn btn--outline","children":"Submit Your Resume"}]]}]]}],["$","$Ld",null,{"href":"/college-of-nursing","className":"careers__nursing","children":[["$","span",null,{"className":"careers__art","children":["$","$Le",null,{"src":"/images/nursing.jpg","alt":"Healthcare trainees in blue scrubs practising with a stethoscope","width":1200,"height":800,"sizes":"(max-width: 960px) 100vw, 38vw","className":"art-photo","quality":80,"decoding":"async","loading":"lazy"}]}],["$","span",null,{"className":"careers__nursing-body","children":[["$","span",null,{"className":"tag tag--white","children":"Indira Gandhi College of Nursing"}],["$","h3",null,{"children":"A four-year B.Sc. Nursing course, taught inside a multispeciality hospital."}],["$","span",null,{"className":"careers__link","children":"Admissions & eligibility →"}]]}]]}]]}]}]
