ose who need it most."}],["$","p","1",{"children":"[Founding members, the original building near Ernakulam South Railway Station, the early years and the new hospital complex inaugurated on 17 September 1986 - additional details need to be collected from IGCH.]"}],"$Lf","$L10"],"$L11"]}],"$L12"]}]]}],"$L13","$L14","$L15","$L16","$L17","$L18","$L19"]}],["$L1a"],"$L1b"]}],"p":"$@1c","v":"$1d","s":"$9"}}]]
