11:["$","ul",null,{"className":"info-card__list","children":[["$","li","Continuous Haemodialysis: A prolonged treatment that continuously filters waste and excess fluid from the blood. It is used for selected critically ill patients.",{"children":"Continuous Haemodialysis: A prolonged treatment that continuously filters waste and excess fluid from the blood. It is used for selected critically ill patients."}],["$","li","Slow Low-Efficiency Dialysis (SLED): A slower form of dialysis carried out over an extended period. It may be suitable for patients who cannot tolerate conventional haemodialysis.",{"children":"Slow Low-Efficiency Dialysis (SLED): A slower form of dialysis carried out over an extended period. It may be suitable for patients who cannot tolerate conventional haemodialysis."}],["$","li","Haemofiltration: A blood purification treatment that removes waste products and excess fluid through filtration.",{"children":"Haemofiltration: A blood purification treatment that removes waste products and excess fluid through filtration."}]]}]
