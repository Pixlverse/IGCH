15:["$","section",null,{"className":"section","children":["$","div",null,{"className":"coop","data-reveal":"","children":[["$","div",null,{"className":"coop__body","children":[["$","span",null,{"className":"tag tag--glass","children":"The co-operative difference"}],["$","h2",null,{"children":["7,000 free dialysis sessions"," ",["$","em",null,{"children":"for those in need."}]]}],["$","p",null,{"children":"We believe everyone deserves access to essential healthcare, regardless of their financial circumstances. As a co-operative hospital in Kochi, IGCH works to make healthcare more accessible through community care initiatives, including free dialysis services and subsidised specialist consultations. Through this model, we aim to reduce the financial burden of medical treatment and help more patients and families access the care they need."}],["$","div",null,{"className":"coop__points","children":[["$","div","Free dialysis",{"children":[["$","strong",null,{"children":"Free dialysis"}],["$","span",null,{"children":"for economically disadvantaged patients"}]]}],["$","div","Weekly camps",{"children":[["$","strong",null,{"children":"Weekly camps"}],["$","span",null,{"children":"free or subsidised specialist consultations"}]]}],["$","div","80G exempt",{"children":[["$","strong",null,{"children":"80G exempt"}],["$","span",null,{"children":"donations go straight into patient care"}]]}]]}],["$","div",null,{"className":"coop__ctas","children":[null,["$","$La","Learn About Us",{"href":"/about","className":"btn btn--outline","children":"Learn About Us"}]]}]]}],["$","div",null,{"className":"coop__art","children":["$","$L2f",null,{"src":"/images/dialysis.jpg","alt":"Dialysis machine beside a patient bed","width":1000,"height":1500,"sizes":"(max-width: 960px) 100vw, (min-width: 1560px) 600px, 40vw","quality":80,"decoding":"async","loading":"lazy"}]}]]}]}]
