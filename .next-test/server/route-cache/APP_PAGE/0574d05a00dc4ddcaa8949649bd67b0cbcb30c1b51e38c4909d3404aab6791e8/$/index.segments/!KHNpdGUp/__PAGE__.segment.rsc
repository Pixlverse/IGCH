18:["$","section",null,{"className":"section","children":["$","div",null,{"className":"faq","data-reveal":"","children":[["$","div",null,{"children":[["$","span",null,{"className":"tag","children":"Quick Check"}],["$","h2",null,{"children":"What Our Patients Often Ask"}]]}],["$","div",null,{"className":"faq__list","children":[["$","details","I'm coming from out of town. How do I plan my visit to IGCH?",{"name":"faq","open":true,"children":[["$","summary",null,{"children":"I'm coming from out of town. How do I plan my visit to IGCH?"}],[["$","p","0",{"children":"You can book your appointment online through our Book an Appointment page, or call us on 0484 294 1600 or [mobile number]. Please bring your ID, past medical reports, any referral letter and your insurance card."}],["$","p","1",{"children":"IGCH is on Gandhinagar Road, Kadavanthra, Kochi. Our Contact Us page has directions from Cochin Airport, Ernakulam South railway station and the KSRTC bus stand. Valet parking is available, so you can drop your car at the entrance and go straight in. Kadavanthra is a busy part of Kochi, so there are hotels and lodges close by if you’re staying over."}]]]}],["$","details","What cancer treatments are available at IGCH, Kochi?",{"name":"faq","children":[["$","summary",null,{"children":"What cancer treatments are available at IGCH, Kochi?"}],[["$","p","0",{"children":"IGCH in Kadavanthra offers cancer treatment in Kochi through medical and surgical oncology. Our oncology team is led by Dr. V.P. Gangadharan, who set up Kerala’s first medical oncology department at the Regional Cancer Centre, Thiruvananthapuram. Dr. Jojo V. Joseph (Surgical Oncology) and Dr. Anupama G (Medical Oncology) work with him."}],["$","p","1",{"children":"We treat all kinds of cancer, with special expertise in breast cancer, colorectal cancer, lung cancer and endocrine tumours. We are also expanding care for head and neck cancer. A team of oncologists, surgeons, radiologists and pathologists reviews every case together, so treatment can start sooner. Counselling, nutrition advice and pain management are part of your care."}]]]}],["$","details","Does IGCH treat children with cancer?",{"name":"faq","children":[["$","summary",null,{"children":"Does IGCH treat children with cancer?"}],[["$","p","0",{"children":"Yes. IGCH in Kadavanthra offers Paediatric Cancer treatment in Kochi. Dr. Anupama G, a Paediatric Oncologist (Child Cancer Specialist) with an MD in Paediatrics and a DM in Medical Oncology, treats children with cancer. Paediatrics, paediatric surgery and neonatology are in the same hospital, along with a 24-hour ICU, operation theatre and blood storage unit. Counselling and nutrition support are available for children and parents. We plan every child’s care around the child and the family."}]]]}],["$","details","Does IGCH, Kochi, offer bypass surgery?",{"name":"faq","children":[["$","summary",null,{"children":"Does IGCH, Kochi, offer bypass surgery?"}],[["$","p","0",{"children":"Yes. IGCH offers heart surgery in Kochi, including bypass surgery, at the Karunya Hridayalaya Cardiac Centre in Kadavanthra. Our cardiac care team coordinates your evaluation, surgery and recovery to ensure continuity of care. With 200 cardiothoracic surgeries completed in 15 months, the centre has experience in managing a range of heart conditions. The hospital also has a 24-hour emergency department, supported by round-the-clock ICU, operation theatre and blood storage unit facilities."}]]]}],["$","details","Does IGCH offer dialysis, and is cashless treatment available?",{"name":"faq","children":["$L35",["$L36","$L37"]]}]]}]]}]}]
19:["$","section",null,{"className":"section","id":"nursing","children":["$","div",null,{"className":"nursing","data-reveal":"","children":[["$","div",null,{"className":"nursing__art","children":["$","$L2f",null,{"src":"/images/nursing.jpg","alt":"Healthcare trainees in blue scrubs practising with a stethoscope","width":1200,"height":800,"sizes":"(max-width: 960px) 100vw, (min-width: 1560px) 680px, 44vw","quality":80,"decoding":"async","loading":"lazy"}]}],["$","div",null,{"className":"nursing__body","children":[["$","span",null,{"children":["$","span",null,{"className":"tag tag--white","children":"Nursing Education"}]}],["$","h2",null,{"children":"College of Nursing, Indira Gandhi Co-operative Hospital, Kochi, Kerala"}],[["$","p","0",{"children":"Indira Gandhi College of Nursing offers B.Sc Nursing in Kadavanthra, Ernakulam, with classroom learning and clinical training in our own multi-speciality hospital. Students gain clinical experience and build the skills to give quality nursing care."}],["$","p","1",{"children":"Check course details, eligibility criteria and the admission process."}]],["$","$La",null,{"href":"/college-of-nursing","className":"btn btn--primary","children":"B.Sc Nursing Admission & Eligibility"}]]}]]}]}]
38:T17a0,{"@context":"https://schema.org","@graph":[{"@type":"Hospital","@id":"https://igchkochi.com/#hospital","name":"Indira Gandhi Co-operative Hospital","url":"https://igchkochi.com/","logo":"https://igchkochi.com/images/officiallog.png","image":"https://igchkochi.com/images/igch-building.jpg","telephone":"+91-484-294-1600","address":{"@type":"PostalAddress","streetAddress":"Gandhinagar Road, opposite Rajiv Gandhi Indoor Stadium, Kadavanthra","addressLocality":"Kochi","addressRegion":"Kerala","postalCode":"682020","addressCountry":"IN"},"openingHoursSpecification":{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],"opens":"00:00","closes":"23:59"},"emergencyService":true,"availableService":[{"@type":"MedicalSpecialty","name":"Cardiology"},{"@type":"MedicalSpecialty","name":"Cardiothoracic & Vascular Surgery"},{"@type":"MedicalSpecialty","name":"Medical Oncology"},{"@type":"MedicalSpecialty","name":"Surgical Oncology"},{"@type":"MedicalSpecialty","name":"Paediatric Oncology"},{"@type":"MedicalSpecialty","name":"Neurology"},{"@type":"MedicalSpecialty","name":"Neurosurgery"},{"@type":"MedicalSpecialty","name":"Gastroenterology"},{"@type":"MedicalSpecialty","name":"Nephrology"},{"@type":"MedicalSpecialty","name":"Urology"},{"@type":"MedicalSpecialty","name":"General Medicine"},{"@type":"MedicalSpecialty","name":"General & Laparoscopic Surgery"},{"@type":"MedicalSpecialty","name":"Obstetrics & Gynaecology"},{"@type":"MedicalSpecialty","name":"Paediatrics"},{"@type":"MedicalSpecialty","name":"Orthopaedics"},{"@type":"MedicalSpecialty","name":"Diabetology"},{"@type":"MedicalSpecialty","name":"Pulmonology"},{"@type":"MedicalSpecialty","name":"ENT"},{"@type":"MedicalSpecialty","name":"Ophthalmology"},{"@type":"MedicalSpecialty","name":"Dermatology"},{"@type":"MedicalSpecialty","name":"Dental & Maxillofacial Surgery"},{"@type":"MedicalSpecialty","name":"Psychiatry"},{"@type":"MedicalSpecialty","name":"Palliative Medicine"},{"@type":"MedicalSpecialty","name":"Ayurveda"},{"@type":"MedicalSpecialty","name":"Emergency Medicine"},{"@type":"MedicalSpecialty","name":"Anaesthesiology"},{"@type":"MedicalSpecialty","name":"Radiology & Imaging"},{"@type":"MedicalSpecialty","name":"Microbiology"},{"@type":"MedicalSpecialty","name":"EECP"},{"@type":"MedicalSpecialty","name":"Physiotherapy"},{"@type":"MedicalSpecialty","name":"Dietetics"}]},{"@type":"FAQPage","@id":"https://igchkochi.com/#faq","mainEntity":[{"@type":"Question","name":"I'm coming from out of town. How do I plan my visit to IGCH?","acceptedAnswer":{"@type":"Answer","text":"You can book your appointment online through our Book an Appointment page, or call us on 0484 294 1600 or [mobile number]. Please bring your ID, past medical reports, any referral letter and your insurance card.\n\nIGCH is on Gandhinagar Road, Kadavanthra, Kochi. Our Contact Us page has directions from Cochin Airport, Ernakulam South railway station and the KSRTC bus stand. Valet parking is available, so you can drop your car at the entrance and go straight in. Kadavanthra is a busy part of Kochi, so there are hotels and lodges close by if you’re staying over."}},{"@type":"Question","name":"What cancer treatments are available at IGCH, Kochi?","acceptedAnswer":{"@type":"Answer","text":"IGCH in Kadavanthra offers cancer treatment in Kochi through medical and surgical oncology. Our oncology team is led by Dr. V.P. Gangadharan, who set up Kerala’s first medical oncology department at the Regional Cancer Centre, Thiruvananthapuram. Dr. Jojo V. Joseph (Surgical Oncology) and Dr. Anupama G (Medical Oncology) work with him.\n\nWe treat all kinds of cancer, with special expertise in breast cancer, colorectal cancer, lung cancer and endocrine tumours. We are also expanding care for head and neck cancer. A team of oncologists, surgeons, radiologists and pathologists reviews every case together, so treatment can start sooner. Counselling, nutrition advice and pain management are part of your care."}},{"@type":"Question","name":"Does IGCH treat children with cancer?","acceptedAnswer":{"@type":"Answer","text":"Yes. IGCH in Kadavanthra offers Paediatric Cancer treatment in Kochi. Dr. Anupama G, a Paediatric Oncologist (Child Cancer Specialist) with an MD in Paediatrics and a DM in Medical Oncology, treats children with cancer. Paediatrics, paediatric surgery and neonatology are in the same hospital, along with a 24-hour ICU, operation theatre and blood storage unit. Counselling and nutrition support are available for children and parents. We plan every child’s care around the child and the family."}},{"@type":"Question","name":"Does IGCH, Kochi, offer bypass surgery?","acceptedAnswer":{"@type":"Answer","text":"Yes. IGCH offers heart surgery in Kochi, including bypass surgery, at the Karunya Hridayalaya Cardiac Centre in Kadavanthra. Our cardiac care team coordinates your evaluation, surgery and recovery to ensure continuity of care. With 200 cardiothoracic surgeries completed in 15 months, the centre has experience in managing a range of heart conditions. The hospital also has a 24-hour emergency department, supported by round-the-clock ICU, operation theatre and blood storage unit facilities."}},{"@type":"Question","name":"Does IGCH offer dialysis, and is cashless treatment available?","acceptedAnswer":{"@type":"Answer","text":"Yes. IGCH in Kadavanthra offers dialysis in Kochi. Our dialysis unit has completed over 15,000 hemodialysis sessions. The hospital’s 24-hour emergency care and ICU are on the same campus.\n\nWe offer cashless treatment through major TPAs and insurance companies. IGCH is also a CGHS-empanelled, NABH-accredited hospital in Kochi. For planned treatment, CGHS patients should bring a referral from their wellness centre. In an emergency, come directly. Please carry your insurance card, photo ID and past reports. As a co-operative hospital, we try to keep care within reach. If cost is a worry, please talk to our team before treatment starts."}}]}]}1a:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$38"}}]
