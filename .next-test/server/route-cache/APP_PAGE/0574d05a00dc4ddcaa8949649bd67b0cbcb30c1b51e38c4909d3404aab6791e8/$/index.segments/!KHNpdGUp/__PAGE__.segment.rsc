11:["$","section",null,{"className":"section","id":"specialities","children":[["$","div",null,{"className":"section-head","data-reveal":"","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"Specialities"}],["$","h2",null,{"className":"h2","children":"Find the right department, then the right doctor."}],""]}],["$","$La",null,{"href":"/specialities","className":"pill-link","children":"All departments →"}]]}],["$","$L31",null,{"groups":[{"slug":"super-specialities","title":"Super Specialities","tagline":"You’re in experienced hands.","summary":"Advanced, single-organ expertise for complex conditions.","icon":"pulse","color":"green","viewAll":{"label":"View all super specialities","href":"/specialities/super-specialities"},"departments":[{"name":"Cardiology","shortName":"","description":"Diagnosis and management of heart conditions, including coronary artery disease, hypertension, heart failure and heart rhythm disorders. The department also provides cardiac services such as pacemaker implantation, where clinically indicated.","href":"#","featured":true,"badge":{"label":"","tone":"green"}},{"name":"Cardiothoracic & Vascular Surgery","shortName":"CTVS","description":"Surgical treatment for conditions affecting the heart, chest and major blood vessels. This includes heart surgery, chest (thoracic) surgery, and vascular and endovascular procedures such as stenting and EVAR, a repair of a swollen aorta from inside the blood vessel.","href":"#","featured":true,"badge":{"label":"","tone":"green"}},{"name":"Medical Oncology","shortName":"","description":"Medical treatment for different types of cancer, including chemotherapy and other drug-based therapies. Treatment plans are based on the type and stage of cancer and the individual patient's needs.","href":"#","featured":true,"badge":{"label":"","tone":"green"}},{"name":"Surgical Oncology","shortName":"","description":"Surgical treatment for cancer, with procedures planned according to the type, location and stage of the disease. Care may be coordinated with medical oncology and other specialists as part of the patient's treatment plan.","href":"#","featured":true,"badge":{"label":"","tone":"green"}},{"name":"Paediatric Oncology","shortName":"","description":"Specialist care for infants, children and adolescents diagnosed with cancer. The department focuses on diagnosis, treatment planning and ongoing care for childhood cancers.","href":"#","featured":true,"badge":{"label":"","tone":"green"}},{"name":"Neurology","shortName":"","description":"Diagnosis and medical treatment of conditions affecting the brain, spinal cord and nerves, including stroke, epilepsy, headaches and migraine, nerve damage (neuropathy) and movement disorders such as Parkinson's disease. The team also provides care for patients with urgent neurological conditions in the emergency department and intensive care unit.","href":"#","featured":true,"badge":{"label":"","tone":"green"}},{"name":"Neurosurgery","shortName":"","description":"Surgical treatment for conditions affecting the brain, spine and nervous system, including brain and spinal tumours, head injuries and spinal disorders.","href":"#","featured":false,"badge":{"label":"","tone":"green"}},{"name":"Gastroenterology","shortName":"","description":"Diagnosis and treatment of problems with the food pipe (oesophagus), stomach, intestines, liver, pancreas and gallbladder, including endoscopy, which uses a thin camera to look inside the digestive tract.","href":"#","featured":false,"badge":{"label":"","tone":"green"}},{"name":"Nephrology","shortName":"","description":"Medical care for acute and chronic kidney disease, kidney-related high blood pressure and complications of kidney failure. The department also manages the hospital’s Dialysis Unit, providing regular haemodialysis and dialysis support for critically ill patients in intensive care.","href":"#","featured":false,"badge":{"label":"","tone":"green"}},{"name":"Urology","shortName":"","description":"Diagnosis and treatment of conditions affecting the kidneys, bladder and urinary tract, as well as the male reproductive system. These include kidney stones, urinary tract infections and prostate conditions. The department also provides care for urinary problems in women and children, along with reconstructive urological procedures.","href":"#","featured":false,"badge":{"label":"","tone":"green"}}]},{"slug":"broad-specialities","title":"Broad Specialities","tagline":"Your family’s health matters at IGCH.","summary":"Everyday and family care, from medicine and surgery to Ayurveda.","icon":"heart","color":"amber","viewAll":{"label":"View all broad specialities","href":"/specialities/broad-specialities"},"departments":[{"name":"General Medicine","shortName":"","description":"Diagnosis and treatment of common illnesses, infections, chronic conditions and other adult health concerns.","href":"#","featured":true,"badge":{"label":"","tone":"green"}},{"name":"General & Laparoscopic Surgery","shortName":"","description":"Surgical care for conditions that may require conventional or minimally invasive procedures.","href":"#","featured":false,"badge":{"label":"","tone":"green"}},{"name":"Obstetrics & Gynaecology","shortName":"","description":"Healthcare for women at different stages of life, including pregnancy, childbirth and gynaecological conditions.","href":"#","featured":true,"badge":{"label":"","tone":"green"}},{"name":"Paediatrics","shortName":"","description":"Medical care for infants, children and adolescents, including the diagnosis and treatment of childhood illnesses.","href":"#","featured":true,"badge":{"label":"","tone":"green"}},{"name":"Orthopaedics","shortName":"","description":"Treatment and management of conditions affecting bones, joints, muscles and the musculoskeletal system, including injuries and fractures.","href":"#","featured":true,"badge":{"label":"","tone":"green"}},{"name":"Diabetology","shortName":"","description":"Care for people with diabetes, including blood sugar management, monitoring and guidance on preventing complications.","href":"#","featured":false,"badge":{"label":"","tone":"green"}},{"name":"Pulmonology","shortName":"","description":"Diagnosis and treatment of conditions affecting the lungs and respiratory system, including asthma and other breathing disorders.","href":"#","featured":false,"badge":{"label":"","tone":"green"}},{"name":"ENT","shortName":"","description":"Medical and surgical care for conditions affecting the ear, nose and throat.","href":"#","featured":false,"badge":{"label":"","tone":"green"}},{"name":"Ophthalmology","shortName":"","description":"Eye examinations, vision care and treatment of eye conditions.","href":"#","featured":false,"badge":{"label":"","tone":"green"}},{"name":"Dermatology","shortName":"","description":"Diagnosis and treatment of skin, hair and nail conditions.","href":"#","featured":false,"badge":{"label":"","tone":"green"}},{"name":"Dental & Maxillofacial Surgery","shortName":"","description":"Dental care and treatment of conditions affecting the teeth, mouth, jaw and facial structures.","href":"#","featured":true,"badge":{"label":"","tone":"green"}},{"name":"Psychiatry","shortName":"","description":"Assessment and treatment of mental health conditions, with support for emotional and psychological wellbeing.","href":"#","featured":false,"badge":{"label":"","tone":"green"}},{"name":"Palliative Medicine","shortName":"","description":"Care focused on relieving pain and other symptoms, improving comfort and supporting patients and families living with serious illnesses.","href":"#","featured":false,"badge":{"label":"New","tone":"lime"}},{"name":"Ayurveda","shortName":"","description":"Traditional Ayurvedic healthcare and treatment based on individual health needs.","href":"#","featured":true,"badge":{"label":"Traditional","tone":"lime"}}]},{"slug":"clinical-support","title":"Clinical Support","tagline":"Quick, careful and kind in our care.","summary":"The teams and technology behind every diagnosis and treatment.","icon":"clipboard","color":"blue","viewAll":{"label":"View all clinical support","href":"/specialities/clinical-support"},"departments":[{"name":"Emergency Medicine","shortName":"","description":"Round-the-clock medical attention for accidents, injuries and sudden illnesses. Our emergency team is available 24 hours a day.","href":"#","featured":true,"badge":{"label":"24/7","tone":"emergency"},"tone":"red"},{"name":"Anaesthesiology","shortName":"","description":"Anaesthesia and pain management services for patients undergoing surgical and other medical procedures.","href":"#","featured":true,"badge":{"label":"","tone":"green"},"tone":"purple"},{"name":"Radiology & Imaging","shortName":"","description":"Diagnostic imaging services, including X-rays, ultrasound and CT scans, to help doctors investigate and assess medical conditions.","href":"#","featured":true,"badge":{"label":"","tone":"green"},"tone":"blue"},{"name":"Microbiology","shortName":"","description":"Laboratory testing to identify bacteria, viruses, fungi and other microorganisms that may cause infections.","href":"#","featured":true,"badge":{"label":"","tone":"green"},"tone":"green"},{"name":"EECP","shortName":"","description":"Enhanced External Counterpulsation (EECP) is a non-invasive treatment used for selected patients with certain heart conditions. Treatment suitability is assessed by a cardiologist.","href":"#","featured":true,"badge":{"label":"","tone":"green"},"tone":"yellow"},{"name":"Physiotherapy","shortName":"","description":"Rehabilitation and physical therapy to help patients improve movement, strength and function after illness, injury or surgery.","href":"#","featured":false,"badge":{"label":"","tone":"green"},"tone":"red"},{"name":"Dietetics","shortName":"","description":"Personalised nutritional guidance to support patients with medical conditions, during treatment and throughout recovery.","href":"#","featured":false,"badge":{"label":"","tone":"green"},"tone":"purple"}]}],"copy":{"head":{"eyebrow":"Specialities","heading":"Find the right department, then the right doctor.","wide":false,"lead":"","link":{"label":"All departments →","href":"/specialities"}},"journey":{"heading":"How it works","steps":[{"label":"Step 01","title":"Choose a group","hint":"Hover a column below","icon":"grid"},{"label":"Step 02","title":"Pick a department","hint":"Point to any department","icon":"search"},{"label":"Step 03","title":"Meet doctors & book","hint":"Profiles, OP timings, booking","icon":"calendar"}]},"filterPlaceholder":"Search {count} departments","filterAriaLabel":"Search departments","helpText":"Not sure? Call {phone} and we'll guide you.","countSuffix":"departments","countOf":"of","emptyText":"No matches in this group."},"phone":{"display":"0484 294 1600","tel":"04842941600","international":"+91-484-294-1600"}}]]}]
