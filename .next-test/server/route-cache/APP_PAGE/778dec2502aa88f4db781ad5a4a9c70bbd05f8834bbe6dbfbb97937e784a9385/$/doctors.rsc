1a:["$","main",null,{"children":[["$","section",null,{"className":"page-hero page-hero--full","children":[["$","div",null,{"className":"page-hero__main","children":[["$","div",null,{"className":"page-hero__body","children":[["$","nav",null,{"className":"crumbs","aria-label":"Breadcrumb","children":["$","ol",null,{"children":[["$","li","/",{"children":["$","$L27",null,{"href":"/","children":"Home"}]}],["$","li","/doctors",{"aria-current":"page","children":"Doctors"}]]}]}],"$undefined",["$","h1",null,{"className":"page-hero__title","children":["Care you can"," ",["$","span",null,{"className":"accent","children":"count on"}],""]}],["$","p",null,{"className":"page-hero__lead","children":"Our doctors work across 30 medical and surgical specialities, with one shared commitment: every patient gets the same attention, clear guidance and good care."}],"$undefined"]}],"$undefined"]}],"$undefined"]}],["$","$L31",null,{"copy":{"heading":"Find a specialist. Plan your consultation.","lead":"Explore the specialist doctors at Indira Gandhi Co-operative Hospital (IGCH). View their qualifications, specialities and consultation details, and book an appointment directly.","searchLabel":"Search doctors","searchPlaceholder":"Search by doctor name or speciality.","quickLabel":"Quick speciality filters","quick":[{"label":"Cardiology","match":"Cardio","href":""},{"label":"Oncology","match":"Oncology","href":""},{"label":"Neurology","match":"Neuro","href":""},{"label":"Orthopaedics","match":"Orthopaedics","href":""},{"label":"General Medicine","match":"General Medicine","href":""},{"label":"Gynaecology","match":"Gynaecology","href":""},{"label":"Paediatrics","match":"Paediatric","href":""},{"label":"More Specialities","match":"","href":"/specialities"}],"specialityLabel":"Speciality","allSpecialities":"All specialities","availabilityLabel":"Consultation availability","anyDay":"Any day","todayOption":"Available today","days":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],"resetLabel":"Clear filters","opdNote":"OPD days and timings for each doctor are being added. To check when a doctor is available, call the appointment desk.","resultsLabel":"{count} doctors found","emptyText":"No doctors match these filters. Try another speciality, or call the appointment desk and we will help you find the right specialist."},"labels":{"qualifications":"Qualifications","experience":"Experience","languages":"Languages","opd":"OPD days & timings","opdFallback":"Call the appointment desk","inToday":"In today","book":"Book appointment","profile":"View profile"},"doctors":[{"name":"Dr. V.P. Gangadharan","department":"Medical Oncology","qualifications":"MBBS, MD (Radiotherapy), MD (Internal Medicine), DM (Medical Oncology)","href":"/doctors/dr-v-p-gangadharan","image":{"src":"/images/gangadharan.jpg","alt":"Portrait of Dr. V.P. Gangadharan","width":660,"height":570},"groups":["super-specialities"],"featured":true,"days":[],"slug":"dr-v-p-gangadharan","title":"Medical & Paediatric Oncologist","designation":"Head of Department, Oncology","experience":"30+ years","languages":"","timings":"","intro":["Dr. V. P. Gangadharan is a medical oncologist associated with Indira Gandhi Co-operative Hospital (IGCH), Kochi. With more than three decades of experience in oncology, he has contributed to the development of specialised cancer care in Kerala through clinical practice, medical education, research and community initiatives."],"overview":["His career includes establishing the Medical Oncology Department at the Regional Cancer Centre (RCC), Thiruvananthapuram, and leading the Medical and Paediatric Oncology Department at VPS Lakeshore Hospital, Kochi. Beyond clinical practice, his work has focused on cancer awareness, early detection and improving access to treatment for patients from economically disadvantaged backgrounds."],"education":["Academic qualifications include:\n- MBBS: Government Medical College, Kottayam.\n- MD (Radiotherapy): All India Institute of Medical Sciences (AIIMS), New Delhi, 1984.\n- MD (Internal Medicine): 1986 – institution to be confirmed.\n- DM (Medical Oncology): Cancer Institute (WIA), Adyar, Chennai, 1989.","International Training\n- Bone Marrow Transplantation Training, Georgetown University Hospital, Washington, DC, USA, 1995.\n- Bone Marrow Transplantation Training, Royal Marsden Hospital, Sutton, UK, 1997.\n- Fellowships associated with the National Cancer Institute, USA, and the World Health Organization."],"journey":["Dr. Gangadharan began his career as a tutor in Radiotherapy and Medical Oncology at Medical College, Thrissur.","In 1989, he joined the Regional Cancer Centre, Thiruvananthapuram, as Assistant Professor and Head of Medical Oncology. During his tenure, he established Kerala's first Medical Oncology Department at the centre.","His professional development included specialised training in bone marrow transplantation in the USA and UK. Following his tenure at RCC, he led the Medical and Paediatric Oncology Department at VPS Lakeshore Hospital, Kochi.","He is now associated with the Medical & Paediatric Oncology team at IGCH, where he contributes to the hospital's oncology services."],"expertise":["- Medical Oncology\n- Paediatric Oncology\n- Medical management of adult cancers\n- Medical management of childhood cancers\n- Cancer counselling and treatment guidance\n- Bone marrow and stem cell transplantation"],"interests":[],"achievements":["Dr. Gangadharan has played a role in developing medical oncology services and advancing cancer care in Kerala. His contributions include establishing the Medical Oncology Department at RCC and participating in the development of blood stem cell transplantation in the state.","He also established the Cochin Cancer Society to support patients who face financial difficulties in accessing cancer treatment. The society's initiatives include patient support, counselling and cancer awareness programmes.","His research contributions include serving as Principal Investigator in 38 national and international multicentre clinical trials. He has also been involved in postgraduate medical education, research supervision and academic assessment."],"research":["Academic and research contributions include:\n- More than 40 publications in national and international medical and oncology journals.\n- Chapters in three medical textbooks.\n- Principal Investigator in 38 national and international multicentre clinical trials.\n- Guidance for ten postgraduate research theses, including studies relating to Ayurveda and music therapy.\n- Peer reviewer for the Journal of Medical and Paediatric Oncology.\n- Invited speaker at more than 60 scientific meetings and seminars.\n- Teaching graduate and postgraduate medical students and examining DM Medical Oncology candidates at universities across India.","Book\n- Jeevithamenna Athbhutham – A Malayalam book published by DC Books, inspired by his experiences and interactions with patients."],"memberships":[],"awards":["His professional and social contributions have been recognised by various organisations. Awards listed in published profiles include:\n- Kerala Sree Award: Government of Kerala, 2023.\n- Kairali Ananthapuri Award: 2012.\n- Basheer Award: Pravasi Doha, 2015.\n- NSH Global Harmony Award: Kuwait, 2017.","His professional profile also records more than 60 awards and recognitions at state, national and international levels."],"approach":["Dr. Gangadharan's work in oncology reflects an emphasis on patient awareness, early detection and access to treatment. His community initiatives also highlight the importance of supporting patients and families through the challenges of cancer care."],"community":["Dr. Gangadharan has been actively involved in cancer awareness, early detection and patient support. Through the Cochin Cancer Society, he has contributed to initiatives that help economically disadvantaged patients access cancer treatment, counselling and other support services.","His public awareness efforts include medical camps, educational programmes and media engagement. He has also been associated with IGCH's cancer care initiatives in collaboration with the society."],"beyond":[]},{"name":"Dr. Jojo V. Joseph","department":"Surgical Oncology","qualifications":"MBBS, MS (General Surgery), MCh (Surgical Oncology)","href":"#","image":{"src":"/images/jojo.jpg","alt":"Portrait of Dr. Jojo V. Joseph","width":660,"height":570},"groups":["super-specialities"],"featured":true,"days":[],"slug":"","title":"","designation":"","experience":"","languages":"","timings":"","intro":[],"overview":[],"education":[],"journey":[],"expertise":[],"interests":[],"achievements":[],"research":[],"memberships":[],"awards":[],"approach":[],"community":[],"beyond":[]},{"name":"Dr. Anupama G","department":"Paediatric Oncology","qualifications":"MD (Pediatrics), DM (Medical Oncology)","href":"#","image":{"src":"/images/doctors/anupama.png","alt":"Portrait of Dr. Anupama G","width":650,"height":570},"groups":["super-specialities"],"featured":false,"days":[],"slug":"","title":"","designation":"","experience":"","languages":"","timings":"","intro":[],"overview":[],"education":[],"journey":[],"expertise":[],"interests":[],"achievements":[],"research":[],"memberships":[],"awards":[],"approach":[],"community":[],"beyond":[]},{"name":"Dr. Nigil Cletus","department":"Cardiology","qualifications":"MBBS, DM (Cardiology), MD (General Medicine)","href":"#","image":{"src":"/images/nigil.jpg","alt":"Portrait of Dr. Nigil Cletus","width":660,"height":570},"groups":["super-specialities"],"featured":true,"days":[],"slug":"","title":"","designation":"","experience":"","languages":"","timings":"","intro":[],"overview":[],"education":[],"journey":[],"expertise":[],"interests":[],"achievements":[],"research":[],"memberships":[],"awards":[],"approach":[],"community":[],"beyond":[]},{"name":"Dr. George J. Valooran","department":"Cardiothoracic & Vascular Surgery","qualifications":"