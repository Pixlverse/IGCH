[{"group":"super-specialities","name":"Cardiology","shortName":"","description":"Diagnosis and management of heart conditions, including coronary artery disease, hypertension, heart failure and heart rhythm disorders. The department also provides cardiac services such as pacemaker implantation, where clinically indicated.","featured":true,"badge":{"label":"","tone":"green"},"href":"#","order":1,"published":true},{"group":"super-specialities","name":"Cardiothoracic & Vascular Surgery","shortName":"CTVS","description":"Surgical treatment for conditions affecting the heart, chest and major blood vessels. This includes heart surgery, chest (thoracic) surgery, and vascular and endovascular procedures such as stenting and EVAR, a repair of a swollen aorta from inside the blood vessel.","featured":true,"badge":{"label":"","tone":"green"},"href":"#","order":2,"published":true},{"group":"super-specialities","name":"Medical Oncology","shortName":"","description":"Medical treatment for different types of cancer, including chemotherapy and other drug-based therapies. Treatment plans are based on the type and stage of cancer and the individual patient's needs.","featured":true,"badge":{"label":"","tone":"green"},"href":"#","order":3,"published":true},{"group":"super-specialities","name":"Surgical Oncology","shortName":"","description":"Surgical treatment for cancer, with procedures planned according to the type, location and stage of the disease. Care may be coordinated with medical oncology and other specialists as part of the patient's treatment plan.","featured":true,"badge":{"label":"","tone":"green"},"href":"#","order":4,"published":true},{"group":"super-specialities","name":"Paediatric Oncology","shortName":"","description":"Specialist care for infants, children and adolescents diagnosed with cancer. The department focuses on diagnosis, treatment planning and ongoing care for childhood cancers.","featured":true,"badge":{"label":"","tone":"green"},"href":"#","order":5,"publ